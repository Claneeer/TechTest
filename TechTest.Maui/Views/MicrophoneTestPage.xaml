<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TechTest.Maui.Controls"
             x:Class="TechTest.Maui.Views.MicrophoneTestPage"
             BackgroundColor="{StaticResource BgPrimary}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- Header with back button -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                    <Button Grid.Column="0"
                            Text="← Voltar"
                            BackgroundColor="{StaticResource BgCard}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="12"
                            BorderColor="{StaticResource Border}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="36"
                            Padding="14,0"
                            Clicked="OnBackClicked" />

                    <Label Grid.Column="1"
                           Text="Teste de Microfone"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"
                           Margin="15,0,0,0" />
                </Grid>

                <!-- Description -->
                <Label Text="Verifique se o microfone integrado está captando áudio corretamente."
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}" />

                <!-- Device picker -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="Dispositivo:"
                           FontSize="13"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center" />
                    <Picker x:Name="PickerDevice"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource BgInput}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="12"
                            HeightRequest="38"
                            HorizontalOptions="Fill" />
                </Grid>

                <!-- Sensitivity slider -->
                <Frame BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="10"
                       Padding="14"
                       HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="🎚 Sensibilidade:"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalTextAlignment="Center" />
                        <Slider x:Name="SliderSensitivity"
                                Grid.Column="1"
                                Minimum="0.5"
                                Maximum="5.0"
                                Value="1.0"
                                MinimumTrackColor="{StaticResource Accent}"
                                MaximumTrackColor="{StaticResource Border}"
                                ThumbColor="{StaticResource AccentLight}"
                                ValueChanged="OnSensitivityChanged" />
                        <Label x:Name="LblSensitivity"
                               Grid.Column="2"
                               Text="1.0x"
                               FontSize="13"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalTextAlignment="Center"
                               WidthRequest="45" />
                    </Grid>
                </Frame>

                <!-- Action buttons -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button x:Name="BtnStart"
                            Grid.Column="0"
                            Text="▶ Iniciar Captura"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="11"
                            CornerRadius="8"
                            HeightRequest="40"
                            Clicked="OnStartClicked" />
                    <Button x:Name="BtnRecord"
                            Grid.Column="1"
                            Text="⏺ Gravar 5s"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="11"
                            CornerRadius="8"
                            HeightRequest="40"
                            IsEnabled="False"
                            Clicked="OnRecordClicked" />
                    <Button x:Name="BtnStop"
                            Grid.Column="2"
                            Text="⏹ Parar"
                            BackgroundColor="{StaticResource BgCard}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="11"
                            CornerRadius="8"
                            HeightRequest="40"
                            BorderColor="{StaticResource Border}"
                            BorderWidth="1"
                            IsEnabled="False"
                            Clicked="OnStopClicked" />
                    <Button x:Name="BtnOpenFolder"
                            Grid.Column="3"
                            Text="📂 Abrir Pasta"
                            BackgroundColor="{StaticResource BgCard}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="11"
                            CornerRadius="8"
                            HeightRequest="40"
                            BorderColor="{StaticResource Border}"
                            BorderWidth="1"
                            Clicked="OnOpenFolderClicked" />
                </Grid>

                <!-- Status label -->
                <Label x:Name="LblStatus"
                       Text="⏸ Aguardando..."
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}" />

                <!-- Waveform area -->
                <Label Text="Forma de Onda:"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}" />

                <Frame BackgroundColor="{StaticResource BgDark}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="8"
                       Padding="0"
                       HasShadow="False">
                    <controls:WaveformCanvasView x:Name="WaveformView"
                                                  HeightRequest="150"
                                                  HorizontalOptions="Fill" />
                </Frame>

                <!-- Volume meter -->
                <Grid ColumnDefinitions="*,70" ColumnSpacing="10">
                    <Frame Grid.Column="0" IsVisible="False" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Volume"
                               FontSize="11"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                        <Frame BackgroundColor="{StaticResource BgDark}"
                               BorderColor="{StaticResource Border}"
                               CornerRadius="6"
                               Padding="4"
                               HasShadow="False"
                               HeightRequest="150">
                            <ProgressBar x:Name="VolumeMeter"
                                         Progress="0"
                                         ProgressColor="{StaticResource Success}"
                                         BackgroundColor="{StaticResource BgDark}"
                                         Rotation="270"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         WidthRequest="140" />
                        </Frame>
                        <Label x:Name="LblVolume"
                               Text="0%"
                               FontSize="11"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Instructions -->
                <Label Text="💡 Dica: Fale ou faça um som próximo ao microfone para testar. Use 'Gravar 5s' para gravar e reproduzir uma amostra. Arquivo salvo em Documentos/TechTest/."
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       Margin="0,10,0,20" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
