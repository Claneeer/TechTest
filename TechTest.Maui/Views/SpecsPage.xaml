<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TechTest.Maui.Controls"
             x:Class="TechTest.Maui.Views.SpecsPage"
             BackgroundColor="{StaticResource BgPrimary}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header with back button -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                    <Button Grid.Column="0"
                            Text="← Voltar"
                            BackgroundColor="{StaticResource BgCard}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="12"
                            BorderColor="{StaticResource Border}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="36"
                            Padding="14,0"
                            Clicked="OnBackClicked" />

                    <Label Grid.Column="1"
                           Text="Especificações do Hardware"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"
                           Margin="15,0,0,0" />
                </Grid>

                <!-- Loading indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="True"
                                   IsVisible="True"
                                   Color="{StaticResource Accent}"
                                   HeightRequest="40"
                                   HorizontalOptions="Center" />

                <!-- Section: Sistema -->
                <Frame x:Name="SectionSistema"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="💻 Sistema"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Fabricante:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblManufacturer" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Modelo:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblModel" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Sistema Operacional:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="LblOS" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="3" Grid.Column="0" Text="Nome da Máquina:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="3" Grid.Column="1" x:Name="LblMachineName" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Processador -->
                <Frame x:Name="SectionCPU"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="⚡ Processador"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="CPU:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblCPU" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Memória RAM -->
                <Frame x:Name="SectionRAM"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🧠 Memória RAM"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Total:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblRAM" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Placas de Vídeo -->
                <Frame x:Name="SectionGPU"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🎮 Placas de Vídeo"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <CollectionView x:Name="GpuList"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               TextColor="{StaticResource TextPrimary}"
                                               FontSize="13" />
                                        <Label Grid.Column="1"
                                               Text="{Binding VRAM}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Tela -->
                <Frame x:Name="SectionDisplay"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📺 Tela"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Resolução:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblResolution" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Taxa de Atualização:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblRefreshRate" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Armazenamento -->
                <Frame x:Name="SectionStorage"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="💾 Armazenamento"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <CollectionView x:Name="DriveList"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="{StaticResource BgInput}"
                                           BorderColor="Transparent"
                                           CornerRadius="8"
                                           Padding="12"
                                           Margin="0,4"
                                           HasShadow="False">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       FontSize="13"
                                                       FontAttributes="Bold" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding DriveType}"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       FontSize="11" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <ProgressBar Grid.Column="0"
                                                             Progress="{Binding UsagePercent}"
                                                             ProgressColor="{StaticResource Accent}"
                                                             BackgroundColor="{StaticResource BgDark}"
                                                             HeightRequest="8"
                                                             VerticalOptions="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding UsageText}"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       FontSize="11"
                                                       WidthRequest="160" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Service Tag -->
                <Frame x:Name="SectionServiceTag"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🏷️ Service Tag"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Número de Série:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblServiceTag" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Copy All button -->
                <Button x:Name="BtnCopyAll"
                        Text="📋 Copiar Tudo"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="{StaticResource TextPrimary}"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="48"
                        HorizontalOptions="Fill"
                        Margin="0,10,0,20"
                        IsVisible="False"
                        Clicked="OnCopyAllClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
