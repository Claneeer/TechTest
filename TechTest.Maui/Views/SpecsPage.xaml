<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TechTest.Maui.Controls"
             x:Class="TechTest.Maui.Views.SpecsPage"
             BackgroundColor="{StaticResource BgPrimary}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header with back button -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                    <Button Grid.Column="0"
                            Text="← Voltar"
                            BackgroundColor="{StaticResource BgCard}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="12"
                            BorderColor="{StaticResource Border}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="36"
                            Padding="14,0"
                            Clicked="OnBackClicked" />

                    <Label Grid.Column="1"
                           Text="Especificações do Hardware"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"
                           Margin="15,0,0,0" />
                </Grid>

                <!-- Loading indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="True"
                                   IsVisible="True"
                                   Color="{StaticResource Accent}"
                                   HeightRequest="40"
                                   HorizontalOptions="Center" />

                <!-- Section: Sistema -->
                <Frame x:Name="SectionSistema"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="💻 Sistema"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Fabricante:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblManufacturer" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Modelo:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblModel" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Sistema Operacional:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="LblOS" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="3" Grid.Column="0" Text="Nome da Máquina:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="3" Grid.Column="1" x:Name="LblMachineName" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Processador -->
                <Frame x:Name="SectionCPU"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="⚡ Processador"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="CPU:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblCPU" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Memória RAM -->
                <Frame x:Name="SectionRAM"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🧠 Memória RAM"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Total:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblRAM" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Placas de Vídeo -->
                <Frame x:Name="SectionGPU"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🎮 Placas de Vídeo"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <CollectionView x:Name="GpuList"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               TextColor="{StaticResource TextPrimary}"
                                               FontSize="13" />
                                        <Label Grid.Column="1"
                                               Text="{Binding VRAM}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Tela -->
                <Frame x:Name="SectionDisplay"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📺 Tela"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Resolução:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblResolution" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Taxa de Atualização:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblRefreshRate" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Armazenamento -->
                <Frame x:Name="SectionStorage"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="💾 Armazenamento"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <CollectionView x:Name="DriveList"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="{StaticResource BgInput}"
                                           BorderColor="Transparent"
                                           CornerRadius="8"
                                           Padding="12"
                                           Margin="0,4"
                                           HasShadow="False">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       FontSize="13"
                                                       FontAttributes="Bold" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding DriveType}"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       FontSize="11" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <ProgressBar Grid.Column="0"
                                                             Progress="{Binding UsagePercent}"
                                                             ProgressColor="{StaticResource Accent}"
                                                             BackgroundColor="{StaticResource BgDark}"
                                                             HeightRequest="8"
                                                             VerticalOptions="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding UsageText}"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       FontSize="11"
                                                       WidthRequest="160" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Saúde S.M.A.R.T. -->
                <Frame x:Name="SectionSmart"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🩺 Saúde do Armazenamento (S.M.A.R.T.)"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <CollectionView x:Name="SmartList" ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="{StaticResource BgInput}"
                                           BorderColor="{Binding HealthColor}"
                                           CornerRadius="8"
                                           Padding="12"
                                           Margin="0,4"
                                           HasShadow="False">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Text="{Binding Name}" TextColor="{StaticResource TextPrimary}" FontSize="13" FontAttributes="Bold" />
                                                <Label Grid.Column="1" Text="{Binding MediaType}" TextColor="{StaticResource TextSecondary}" FontSize="11" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <ProgressBar Grid.Column="0" Progress="{Binding HealthFraction}" ProgressColor="{Binding HealthColor}" BackgroundColor="{StaticResource BgDark}" HeightRequest="8" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding HealthStatus}" TextColor="{Binding HealthColor}" FontSize="12" FontAttributes="Bold" />
                                            </Grid>
                                            <Label Text="{Binding Summary}" TextColor="{StaticResource TextSecondary}" FontSize="11" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label x:Name="LblSmartNote"
                               IsVisible="False"
                               Text="ℹ️ Desgaste, temperatura e horas ligado só são expostos pelo Windows quando o app roda como administrador (e se o disco suportar)."
                               TextColor="{StaticResource Warning}"
                               FontSize="11" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Bateria -->
                <Frame x:Name="SectionBattery"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🔋 Bateria e Energia"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Status:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblBatteryStatus" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Fonte / Carga:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblBatteryPower" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Saúde da Bateria:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="LblBatteryHealth" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" FontAttributes="Bold" />
                            <Label Grid.Row="3" Grid.Column="0" Text="Capacidade / Ciclos:" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            <Label Grid.Row="3" Grid.Column="1" x:Name="LblBatteryCapacity" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section: Service Tag -->
                <Frame x:Name="SectionServiceTag"
                       BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🏷️ Service Tag"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto" RowSpacing="8" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="Número de Série:" TextColor="{StaticResource TextSecondary}" FontSize="13" VerticalTextAlignment="Center" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblServiceTag" Text="—" TextColor="{StaticResource TextPrimary}" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    x:Name="BtnCopySn"
                                    Text="{Binding CopySnButtonText}"
                                    Command="{Binding CopySerialNumberCommand}"
                                    IsEnabled="{Binding IsCopySnEnabled}"
                                    BackgroundColor="{StaticResource BgPrimary}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Accent}"
                                    BorderWidth="1"
                                    FontSize="12"
                                    CornerRadius="8"
                                    HeightRequest="34"
                                    Padding="12,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Driver updater -->
                <Button x:Name="BtnDrivers"
                        Text="🔧 Atualizador de Drivers OEM"
                        BackgroundColor="{StaticResource BgCard}"
                        TextColor="{StaticResource TextPrimary}"
                        BorderColor="{StaticResource Accent}"
                        BorderWidth="1"
                        FontSize="14"
                        CornerRadius="10"
                        HeightRequest="48"
                        Margin="0,10,0,0"
                        Clicked="OnDriversClicked" />

                <!-- Ferramentas: FurMark + configuração de rede (XML) -->
                <Frame BackgroundColor="{StaticResource BgCard}"
                       BorderColor="{StaticResource Border}"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🧪 Ferramentas"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView Color="{StaticResource Border}" HeightRequest="1" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="BtnFurMark"
                                    Grid.Column="0"
                                    Text="🔥 Iniciar FurMark"
                                    BackgroundColor="{StaticResource BgPrimary}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Border}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    HeightRequest="42"
                                    Clicked="OnFurMarkClicked" />
                            <Button x:Name="BtnNetworkXml"
                                    Grid.Column="1"
                                    Text="🌐 Config. de Rede (XML)"
                                    BackgroundColor="{StaticResource BgPrimary}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Border}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    HeightRequest="42"
                                    Clicked="OnNetworkConfigClicked" />
                        </Grid>
                        <Label x:Name="LblToolStatus"
                               Text=""
                               FontSize="12"
                               IsVisible="False"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Copy All button -->
                <Button x:Name="BtnCopyAll"
                        Text="{Binding CopyAllButtonText}"
                        Command="{Binding CopyAllInfoCommand}"
                        IsEnabled="{Binding IsCopyAllEnabled}"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="{StaticResource TextPrimary}"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="48"
                        HorizontalOptions="Fill"
                        Margin="0,10,0,20"
                        IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
