<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Ignora a pasta de fallback do Visual Studio (D:\Localinutil) que pode não existir na máquina -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
